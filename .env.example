# ╔══════════════════════════════════════════════╗
# ║        TELEGRAM SUBDOMAIN BOT — .env         ║
# ╚══════════════════════════════════════════════╝

# ── Telegram ───────────────────────────────────────
# @BotFather se /newbot karke token lo
BOT_TOKEN=1234567890:ABCDEFghijklmnopqrstuvwxyz

# Aapka Telegram User ID (admin)
# @userinfobot se pata karo
ADMIN_ID=123456789

# ── Domain ─────────────────────────────────────────
DOMAIN=yourdomain.com

# ── Cloudflare (Auto-DNS ke liye) ──────────────────
# cloudflare.com → My Profile → API Tokens → Create Token → "Edit zone DNS"
CF_API_TOKEN=your_cloudflare_api_token

# Dashboard → apna domain → Right sidebar → Zone ID
CF_ZONE_ID=your_cloudflare_zone_id

# ── Optional: Email Notifications ──────────────────
# Gmail: Google Account → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ── Settings ───────────────────────────────────────
MAX_SUBDOMAINS_PER_USER=3
REQUIRE_APPROVAL=true
